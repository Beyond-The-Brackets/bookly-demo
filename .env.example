# Copy to .env.local and fill in the values printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only, never NEXT_PUBLIC_. Printed by `npx supabase status -o env` as SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe test mode. `stripe listen --forward-to localhost:3000/api/stripe` prints the webhook secret.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
